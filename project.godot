; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows to do so.

[configuration]

config_version=5

[application]

config/name="superN"
config/description="A 2D platform fighter inspired by Superfighters Deluxe. Built with Godot 4 C#."
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

2d/default_gravity=980.0
2d/default_gravity_vector=Vector2(0, 1)
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"

